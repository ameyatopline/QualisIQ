  "components": {
    "schemas": {
      "CAPAIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240,
            "minLength": 12,
            "title": "Title"
          },
          "assigned_to_id": {
            "type": "integer",
            "title": "Assigned To Id"
          },
          "due_at": {
            "type": "string",
            "format": "date-time",
            "title": "Due At"
          }
        },
        "type": "object",
        "required": [
          "title",
          "assigned_to_id",
          "due_at"
        ],
        "title": "CAPAIn"
      },
      "CAPAUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "effectiveness_note": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 12,
            "title": "Effectiveness Note"
          }
        },
        "type": "object",
        "required": [
          "status",
          "effectiveness_note"
        ],
        "title": "CAPAUpdate"
      },
      "EvidenceIn": {
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 50,
            "minLength": 3,
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "maxLength": 240,
            "minLength": 5,
            "title": "Label"
          },
          "reference_uri": {
            "type": "string",
            "maxLength": 500,
            "minLength": 6,
            "title": "Reference Uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "label",
          "reference_uri",
          "sha256"
        ],
        "title": "EvidenceIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvestigationUpdate": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 12,
